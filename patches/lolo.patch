+// GetPbGachaInfo reports the same shared guarantee counter used by the draw engine.
+// The Steam UI displays this value directly as the remaining number of draws.
+func (g *GachaModel) GetPbGachaInfo(id uint32) *proto.GachaInfo {
+	conf := gdconf.GetGachaData(id)
+	if conf == nil || conf.Conf == nil {
+		return nil
+	}
+	result := g.GetGachaInfo(id).GachaInfo()
+	probability := gdconf.GetGachaProbability(conf.Conf.NewUIGachaType)
+	if probability == nil {
+		return result
+	}
+	kind := proto.EUIGachaType(conf.Conf.NewUIGachaType)
+	if kind == proto.EUIGachaType_EUIGachaType_New || kind == proto.EUIGachaType_EUIGachaType_Default || kind == proto.EUIGachaType_EUIGachaType_Limit {
+		remaining := probability.GuaranteeSSR - g.GetGachaTypeInfo(kind).GuaranteeSSR
+		if remaining < 1 {
+			remaining = 1
+		}
+		result.Guarantee = uint32(remaining)
+	}
+	return result
+}
